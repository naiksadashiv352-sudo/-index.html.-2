<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#08090d">
<meta name="apple-mobile-web-app-capable" content="yes">

<title>Arrow Clash</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

:root{
  --bg:#08090d;
  --panel:#11131a;
  --panel2:#181b24;
  --text:#f7f7fa;
  --muted:#9da2b2;
  --red:#ff4057;
  --red2:#ff7181;
  --blue:#4295ff;
  --green:#45d483;
  --yellow:#ffd35a;
  --line:#292d39;
  --cell:#191c25;
}

html,body{
  margin:0;
  padding:0;
  min-height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}

body{
  min-height:100vh;
  overflow-x:hidden;
}

button{
  font:inherit;
}

.app{
  width:100%;
  min-height:100vh;
  padding:18px;
  display:flex;
  justify-content:center;
}

.container{
  width:min(760px,100%);
  min-height:calc(100vh - 36px);
  display:flex;
  flex-direction:column;
}

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:8px 0 22px;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:900;
  font-size:20px;
  letter-spacing:.5px;
}

.logo-icon{
  width:38px;
  height:38px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:var(--red);
  color:white;
  font-size:23px;
  box-shadow:0 8px 25px rgba(255,64,87,.25);
}

.header-best{
  color:var(--muted);
  font-size:13px;
}

.screen{
  flex:1;
}

.hero{
  padding:45px 10px 30px;
  text-align:center;
}

.hero h1{
  margin:0;
  font-size:clamp(48px,12vw,82px);
  line-height:.9;
  letter-spacing:-4px;
  font-weight:950;
}

.hero h1 span{
  color:var(--red);
}

.hero p{
  color:var(--muted);
  font-size:16px;
  margin:20px auto 35px;
  max-width:500px;
  line-height:1.5;
}

.primary{
  border:0;
  width:100%;
  max-width:460px;
  min-height:58px;
  padding:15px 22px;
  border-radius:18px;
  background:var(--red);
  color:#fff;
  font-weight:850;
  font-size:17px;
  cursor:pointer;
  box-shadow:0 12px 30px rgba(255,64,87,.22);
  transition:.15s;
}

.primary:active{
  transform:scale(.97);
}

.secondary{
  border:1px solid var(--line);
  width:100%;
  max-width:460px;
  min-height:54px;
  margin-top:12px;
  padding:14px 20px;
  border-radius:17px;
  background:var(--panel);
  color:var(--text);
  font-weight:750;
  cursor:pointer;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  max-width:520px;
  margin:30px auto 0;
}

.stat{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:16px;
  padding:15px 8px;
  text-align:center;
}

.stat small{
  display:block;
  color:var(--muted);
  font-size:10px;
  font-weight:700;
  margin-bottom:5px;
}

.stat strong{
  font-size:20px;
}

.title{
  font-size:30px;
  font-weight:900;
  margin:15px 0 6px;
}

.subtitle{
  color:var(--muted);
  margin:0 0 22px;
}

.mode-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-bottom:25px;
}

.mode{
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:17px;
  padding:17px 8px;
  cursor:pointer;
  min-height:95px;
}

.mode.selected{
  border-color:var(--red);
  background:#21151a;
}

.mode-icon{
  font-size:25px;
  display:block;
  margin-bottom:7px;
}

.mode b{
  display:block;
  font-size:13px;
}

.mode small{
  color:var(--muted);
  font-size:10px;
}

.level-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.level{
  position:relative;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:18px;
  padding:17px;
  text-align:left;
  min-height:100px;
  cursor:pointer;
}

.level.locked{
  opacity:.42;
}

.level-number{
  color:var(--red);
  font-size:12px;
  font-weight:900;
}

.level-name{
  display:block;
  font-weight:850;
  margin-top:5px;
}

.level-best{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-top:7px;
}

.back{
  border:0;
  background:var(--panel);
  color:var(--text);
  width:44px;
  height:44px;
  border-radius:14px;
  cursor:pointer;
  font-size:22px;
  margin-bottom:15px;
}

.game-top{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
  margin-bottom:12px;
}

.hud{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:15px;
  padding:11px 8px;
  text-align:center;
}

.hud small{
  display:block;
  color:var(--muted);
  font-size:9px;
  font-weight:800;
}

.hud strong{
  font-size:19px;
}

.racers{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
  margin-bottom:12px;
}

.racer{
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:14px;
  padding:10px;
  display:flex;
  align-items:center;
  gap:9px;
}

.racer.you{
  border-color:var(--blue);
}

.racer.bot{
  border-color:var(--red);
}

.racer-dot{
  width:30px;
  height:30px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--blue);
  font-size:13px;
  font-weight:900;
}

.racer.bot .racer-dot{
  background:var(--red);
}

.racer-info{
  min-width:0;
}

.racer-info b{
  display:block;
  font-size:12px;
}

.racer-info small{
  color:var(--muted);
  font-size:10px;
}

.board-wrap{
  position:relative;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:22px;
  padding:12px;
}

.board{
  width:100%;
  max-width:650px;
  margin:auto;
  aspect-ratio:1;
  display:grid;
  gap:5px;
}

.cell{
  border:0;
  border-radius:10px;
  background:var(--cell);
  color:#fff;
  font-size:clamp(15px,5vw,28px);
  font-weight:950;
  display:grid;
  place-items:center;
  cursor:pointer;
  position:relative;
  transition:.12s;
  box-shadow:inset 0 0 0 1px #242936;
}

.cell:active{
  transform:scale(.93);
}

.cell.current{
  box-shadow:inset 0 0 0 3px var(--blue);
  background:#14243a;
}

.cell.bot-current{
  box-shadow:inset 0 0 0 3px var(--red);
  background:#35151c;
}

.cell.valid{
  background:#172b22;
  box-shadow:inset 0 0 0 2px var(--green);
}

.cell.visited{
  opacity:.5;
}

.cell.start{
  background:#202532;
}

.cell.target{
  background:#302918;
}

.player-token{
  position:absolute;
  width:24%;
  aspect-ratio:1;
  border-radius:50%;
  background:var(--blue);
  border:4px solid #fff;
  z-index:5;
  pointer-events:none;
  transform:translate(-50%,-50%);
  transition:.18s;
  box-shadow:0 5px 20px rgba(66,149,255,.45);
}

.bot-token{
  position:absolute;
  width:24%;
  aspect-ratio:1;
  border-radius:50%;
  background:var(--red);
  border:4px solid #fff;
  z-index:4;
  pointer-events:none;
  transform:translate(-50%,-50%);
  transition:.18s;
  box-shadow:0 5px 20px rgba(255,64,87,.4);
}

.message{
  text-align:center;
  color:var(--muted);
  font-size:13px;
  min-height:20px;
  margin:12px 0 5px;
}

.controls{
  display:grid;
  grid-template-columns:repeat(3,58px);
  justify-content:center;
  gap:7px;
  margin:15px 0;
}

.controls button{
  width:58px;
  height:48px;
  border:1px solid var(--line);
  background:var(--panel);
  color:white;
  border-radius:14px;
  font-size:20px;
  cursor:pointer;
}

.controls button:active{
  transform:scale(.92);
}

.pause-row{
  display:flex;
  gap:9px;
  justify-content:center;
  margin-bottom:20px;
}

.small-btn{
  border:1px solid var(--line);
  background:var(--panel);
  color:white;
  padding:11px 18px;
  border-radius:13px;
  cursor:pointer;
  font-weight:700;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.78);
  display:grid;
  place-items:center;
  padding:20px;
  z-index:50;
}

.modal-box{
  width:min(440px,100%);
  background:#151821;
  border:1px solid #303542;
  border-radius:24px;
  padding:28px;
  text-align:center;
  box-shadow:0 25px 80px rgba(0,0,0,.5);
}

.modal-box h2{
  font-size:32px;
  margin:0 0 10px;
}

.modal-box p{
  color:var(--muted);
  line-height:1.5;
}

.result-score{
  font-size:48px;
  font-weight:950;
  color:var(--red);
  margin:15px;
}

.hidden{
  display:none!important;
}

.footer{
  text-align:center;
  color:#666b78;
  font-size:10px;
  padding:25px 0 10px;
}

@media(max-width:480px){
  .app{
    padding:12px;
  }

  .container{
    min-height:calc(100vh - 24px);
  }

  .hero{
    padding-top:35px;
  }

  .hero h1{
    font-size:58px;
  }

  .level-grid{
    gap:9px;
  }

  .cell{
    border-radius:7px;
  }
}
</style>
</head>

<body>

<div class="app">
<div class="container">

<header>
  <div class="logo">
    <div class="logo-icon">➜</div>
    <span>ARROW CLASH</span>
  </div>
  <div class="header-best">
    BEST <strong id="headerBest">0</strong>
  </div>
</header>

<!-- HOME -->
<section id="homeScreen" class="screen">

  <div class="hero">
    <h1>ARROW<br><span>CLASH</span></h1>

    <p>
      Follow the arrows. Choose your path.
      Reach the finish before your opponent.
    </p>

    <button class="primary" onclick="showLevels()">
      PLAY NOW
    </button>

    <button class="secondary" onclick="showHowToPlay()">
      HOW TO PLAY
    </button>

    <div class="stats">
      <div class="stat">
        <small>LEVEL</small>
        <strong id="homeLevel">1</strong>
      </div>

      <div class="stat">
        <small>BEST SCORE</small>
        <strong id="homeBest">0</strong>
      </div>

      <div class="stat">
        <small>WINS</small>
        <strong id="homeWins">0</strong>
      </div>
    </div>
  </div>

  <div class="footer">
    Arrow Clash • Play in your browser
  </div>

</section>

<!-- LEVELS -->
<section id="levelsScreen" class="screen hidden">

  <button class="back" onclick="goHome()">‹</button>

  <div class="title">Choose a level</div>
  <p class="subtitle">Select your challenge.</p>

  <div class="mode-grid">

    <button class="mode selected" id="modeBot" onclick="setMode('bot')">
      <span class="mode-icon">🤖</span>
      <b>VS BOT</b>
      <small>Race the computer</small>
    </button>

    <button class="mode" id="modeLocal" onclick="setMode('local')">
      <span class="mode-icon">👥</span>
      <b>2 PLAYERS</b>
      <small>Take turns</small>
    </button>

    <button class="mode" id="modePractice" onclick="setMode('practice')">
      <span class="mode-icon">🎯</span>
      <b>PRACTICE</b>
      <small>Play alone</small>
    </button>

  </div>

  <div class="level-grid" id="levelGrid"></div>

</section>

<!-- GAME -->
<section id="gameScreen" class="screen hidden">

  <button class="back" onclick="exitGame()">‹</button>

  <div class="game-top">

    <div class="hud">
      <small>TIME</small>
      <strong id="timer">00:00</strong>
    </div>

    <div class="hud">
      <small>SCORE</small>
      <strong id="score">0</strong>
    </div>

    <div class="hud">
      <small>LEVEL</small>
      <strong id="levelDisplay">1</strong>
    </div>

  </div>

  <div class="racers">

    <div class="racer you">
      <div class="racer-dot">1</div>
      <div class="racer-info">
        <b>PLAYER</b>
        <small id="playerStatus">Your turn</small>
      </div>
    </div>

    <div class="racer bot">
      <div class="racer-dot">2</div>
      <div class="racer-info">
        <b id="opponentName">BOT</b>
        <small id="opponentStatus">Racing</small>
      </div>
    </div>

  </div>

  <div class="board-wrap">
    <div id="board" class="board"></div>
    <div id="playerToken" class="player-token"></div>
    <div id="botToken" class="bot-token"></div>
  </div>

  <div id="message" class="message">
    Follow the arrow from your current tile.
  </div>

  <div class="controls">
    <div></div>
    <button onclick="move('up')">↑</button>
    <div></div>

    <button onclick="move('left')">←</button>
    <button onclick="move('down')">↓</button>
    <button onclick="move('right')">→</button>
  </div>

  <div class="pause-row">
    <button class="small-btn" onclick="restartGame()">↻ Restart</button>
    <button class="small-btn" onclick="exitGame()">Exit</button>
  </div>

</section>

</div>
</div>

<!-- RESULT MODAL -->
<div id="resultModal" class="modal hidden">

  <div class="modal-box">

    <h2 id="resultTitle">You Win!</h2>

    <p id="resultText">
      Great race!
    </p>

    <div class="result-score" id="resultScore">
      0
    </div>

    <button class="primary" onclick="nextLevel()">
      NEXT LEVEL
    </button>

    <button class="secondary" onclick="showLevels()">
      LEVEL SELECT
    </button>

  </div>

</div>

<!-- HOW TO PLAY -->
<div id="howModal" class="modal hidden">

  <div class="modal-box">

    <h2>How to Play</h2>

    <p>
      Every tile has an arrow. That arrow tells you
      which direction you can move next.
    </p>

    <p>
      Reach the gold finish tile as quickly as possible.
      Faster time means a higher score.
    </p>

    <p>
      In VS BOT mode, the computer races against you.
    </p>

    <button class="primary" onclick="closeHow()">
      GOT IT
    </button>

  </div>

</div>

<script>
"use strict";

/* =========================
   GAME DATA
========================= */

const levelNames = [
  "First Steps",
  "Two Ways Out",
  "Corner Turn",
  "Cross Traffic",
  "Quick Decisions",
  "Switchback",
  "Branch Out",
  "Full Throttle",
  "Close Quarters",
  "Final Clash"
];

const levelSizes = [
  5,5,5,6,6,6,7,7,7,8
];

let mode = "bot";
let currentLevel = 1;

let boardData = [];
let boardSize = 5;

let playerPos = 0;
let botPos = 0;

let finishPos = 0;

let startTime = 0;
let elapsed = 0;

let timerInterval = null;
let botInterval = null;

let gameRunning = false;

let score = 0;

let wins = 0;

let saveData = {
  unlocked:1,
  best:0,
  wins:0,
  levelBest:{}
};

/* =========================
   SAVE / LOAD
========================= */

function loadSave(){

  try{

    const saved = localStorage.getItem("arrowClashSave");

    if(saved){
      const parsed = JSON.parse(saved);

      saveData = {
        ...saveData,
        ...parsed
      };

      if(!saveData.levelBest){
        saveData.levelBest = {};
      }
    }

  }catch(e){

    console.log("Save load failed");

  }

  wins = saveData.wins || 0;

  updateHome();

}

function save(){

  try{

    localStorage.setItem(
      "arrowClashSave",
      JSON.stringify(saveData)
    );

  }catch(e){

    console.log("Save failed");

  }

}

/* =========================
   BASIC UI
========================= */

function $(id){
  return document.getElementById(id);
}

function updateHome(){

  $("homeLevel").textContent =
    saveData.unlocked || 1;

  $("homeBest").textContent =
    saveData.best || 0;

  $("homeWins").textContent =
    saveData.wins || 0;

  $("headerBest").textContent =
    saveData.best || 0;

}

function hideAllScreens(){

  $("homeScreen").classList.add("hidden");
  $("levelsScreen").classList.add("hidden");
  $("gameScreen").classList.add("hidden");

}

function goHome(){

  stopGameTimers();

  hideAllScreens();

  $("homeScreen").classList.remove("hidden");

  updateHome();

}

function showLevels(){

  stopGameTimers();

  hideAllScreens();

  $("levelsScreen").classList.remove("hidden");

  renderLevels();

}

function showHowToPlay(){

  $("howModal").classList.remove("hidden");

}

function closeHow(){

  $("howModal").classList.add("hidden");

}

/* =========================
   MODES
========================= */

function setMode(newMode){

  mode = newMode;

  $("modeBot").classList.remove("selected");
  $("modeLocal").classList.remove("selected");
  $("modePractice").classList.remove("selected");

  if(mode === "bot"){
    $("modeBot").classList.add("selected");
  }

  if(mode === "local"){
    $("modeLocal").classList.add("selected");
  }

  if(mode === "practice"){
    $("modePractice").classList.add("selected");
  }

  renderLevels();

}

/* =========================
   LEVELS
========================= */

function renderLevels(){

  const grid = $("levelGrid");

  grid.innerHTML = "";

  const unlocked =
    saveData.unlocked || 1;

  for(let i=1;i<=10;i++){

    const button =
      document.createElement("button");

    button.className = "level";

    if(i > unlocked){
      button.classList.add("locked");
    }

    const best =
      saveData.levelBest[i] || 0;

    button.innerHTML = `
      <span class="level-number">
        LEVEL ${i}
      </span>

      <span class="level-name">
        ${levelNames[i-1]}
      </span>

      <span class="level-best">
        ${i > unlocked ? "🔒 Locked" :
          best ? "Best: " + best : "Not played"}
      </span>
    `;

    if(i <= unlocked){

      button.onclick = () => {
        startGame(i);
      };

    }

    grid.appendChild(button);

  }

}

/* =========================
   BOARD GENERATION
========================= */

const directions = [
  {name:"up",dx:0,dy:-1,glyph:"↑"},
  {name:"right",dx:1,dy:0,glyph:"→"},
  {name:"down",dx:0,dy:1,glyph:"↓"},
  {name:"left",dx:-1,dy:0,glyph:"←"}
];

function indexFromXY(x,y){
  return y * boardSize + x;
}

function xyFromIndex(index){

  return {
    x:index % boardSize,
    y:Math.floor(index / boardSize)
  };

}

function validDirections(index){

  const p = xyFromIndex(index);

  return directions.filter(d => {

    const nx = p.x + d.dx;
    const ny = p.y + d.dy;

    return (
      nx >= 0 &&
      nx < boardSize &&
      ny >= 0 &&
      ny < boardSize
    );

  });

}

function neighbor(index, direction){

  const p = xyFromIndex(index);

  const d =
    directions.find(x => x.name === direction);

  if(!d) return null;

  const nx = p.x + d.dx;
  const ny = p.y + d.dy;

  if(
    nx < 0 ||
    nx >= boardSize ||
    ny < 0 ||
    ny >= boardSize
  ){
    return null;
  }

  return indexFromXY(nx,ny);

}

/*
 Create a guaranteed path from START
 to FINISH. Other cells get random arrows.
*/

function generateBoard(){

  boardSize =
    levelSizes[currentLevel-1];

  const total =
    boardSize * boardSize;

  boardData =
    new Array(total);

  for(let i=0;i<total;i++){

    const dirs =
      validDirections(i);

    const random =
      dirs[
        Math.floor(
          Math.random() * dirs.length
        )
      ];

    boardData[i] =
      random.name;

  }

  /*
   Guaranteed route:
   create a shuffled path through
   neighboring cells.
  */

  const path = [];

  let current = 0;

  path.push(current);

  const visited =
    new Set([current]);

  const target =
    total - 1;

  let attempts = 0;

  while(current !== target && attempts < 5000){

    attempts++;

    const p =
      xyFromIndex(current);

    let choices =
      validDirections(current)
      .filter(d => {

        const n =
          neighbor(current,d.name);

        return !visited.has(n);

      });

    /*
     Prefer moving toward bottom-right.
    */

    choices.sort(() => Math.random()-.5);

    choices.sort((a,b)=>{

      const na =
        neighbor(current,a.name);

      const nb =
        neighbor(current,b.name);

      const pa =
        xyFromIndex(na);

      const pb =
        xyFromIndex(nb);

      const da =
        Math.abs(target % boardSize - pa.x) +
        Math.abs(Math.floor(target/boardSize)-pa.y);

      const db =
        Math.abs(target % boardSize - pb.x) +
        Math.abs(Math.floor(target/boardSize)-pb.y);

      return da - db;

    });

    if(!choices.length){

      /*
       Restart if trapped.
      */

      path.length = 0;
      visited.clear();

      current = 0;
      path.push(0);
      visited.add(0);

      continue;

    }

    const chosen =
      choices[
        Math.random() <
        .75 ? 0 :
        Math.floor(Math.random()*choices.length)
      ];

    const next =
      neighbor(current,chosen.name);

    boardData[current] =
      chosen.name;

    current = next;

    path.push(current);

    visited.add(current);

  }

  finishPos =
    total - 1;

  /*
   Make finish reachable from
   previous path cell.
  */

  if(path.length >= 2){

    const before =
      path[path.length-2];

    const dirs =
      validDirections(before);

    const wanted =
      dirs.find(d =>
        neighbor(before,d.name) === finishPos
      );

    if(wanted){
      boardData[before] =
        wanted.name;
    }

  }

  playerPos = 0;

  /*
   Bot starts at top-left too.
  */

  botPos = 0;

}

/* =========================
   START GAME
========================= */

function startGame(level){

  currentLevel = level;

  generateBoard();

  score = 0;

  elapsed = 0;

  gameRunning = true;

  hideAllScreens();

  $("gameScreen").classList.remove("hidden");

  $("levelDisplay").textContent =
    currentLevel;

  $("score").textContent = "0";

  $("opponentName").textContent =
    mode === "bot" ? "BOT" :
    mode === "local" ? "PLAYER 2" :
    "TARGET";

  $("message").textContent =
    "Follow the arrow from your current tile.";

  $("playerStatus").textContent =
    "Your turn";

  $("opponentStatus").textContent =
    mode === "practice" ? "Finish" : "Racing";

  renderBoard();

  startTimer();

  if(mode === "bot"){

    startBot();

  }

}

/* =========================
   RENDER BOARD
========================= */

function renderBoard(){

  const board =
    $("board");

  board.innerHTML = "";

  board.style.gridTemplateColumns =
    `repeat(${boardSize},1fr)`;

  board.style.gridTemplateRows =
    `repeat(${boardSize},1fr)`;

  for(let i=0;i<boardData.length;i++){

    const cell =
      document.createElement("button");

    cell.className = "cell";

    const arrow =
      directions.find(
        d => d.name === boardData[i]
      );

    cell.textContent =
      arrow ? arrow.glyph : "?";

    if(i === playerPos){
      cell.classList.add("current");
    }

    if(
      mode !== "practice" &&
      i === botPos
    ){
      cell.classList.add("bot-current");
    }

    if(i === finishPos){
      cell.classList.add("target");
      cell.textContent = "★";
    }

    if(i === 0){
      cell.classList.add("start");
    }

    cell.onclick = () => {

      /*
       Player can click a cell only if
       it is the legal next cell.
      */

      const next =
        getNextPosition(playerPos);

      if(i === next){

        moveTo(i);

      }

    };

    board.appendChild(cell);

  }

  positionTokens();

}

function positionTokens(){

  const board =
    $("board");

  const rect =
    board.getBoundingClientRect();

  if(!rect.width) return;

  function place(token,index){

    const p =
      xyFromIndex(index);

    const x =
      ((p.x + .5) / boardSize) * 100;

    const y =
      ((p.y + .5) / boardSize) * 100;

    token.style.left = x + "%";
    token.style.top = y + "%";

  }

  place(
    $("playerToken"),
    playerPos
  );

  if(mode === "practice"){

    $("botToken").classList.add("hidden");

  }else{

    $("botToken").classList.remove("hidden");

    place(
      $("botToken"),
      botPos
    );

  }

}

/* =========================
   PLAYER MOVEMENT
========================= */

function getNextPosition(position){

  const direction =
    boardData[position];

  return neighbor(
    position,
    direction
  );

}

function move(direction){

  if(!gameRunning) return;

  const allowed =
    boardData[playerPos];

  if(allowed !== direction){

    $("message").textContent =
      "Follow the arrow: " +
      directions.find(
        d=>d.name===allowed
      ).glyph;

    return;

  }

  const next =
    neighbor(
      playerPos,
      direction
    );

  if(next === null){

    $("message").textContent =
      "You cannot move outside the board.";

    return;

  }

  moveTo(next);

}

function moveTo(next){

  if(!gameRunning) return;

  const expected =
    getNextPosition(playerPos);

  if(next !== expected){

    return;

  }

  playerPos = next;

  /*
   Score rewards speed.
  */

  score += 100;

  $("score").textContent =
    score;

  renderBoard();

  if(playerPos === finishPos){

    finishGame(true);

    return;

  }

  $("message").textContent =
    "Good move! Follow the next arrow.";

}

/* =========================
   BOT
========================= */

function startBot(){

  stopBot();

  /*
   Bot speed increases with level.
  */

  const delay =
    Math.max(
      250,
      850 - currentLevel * 50
    );

  botInterval =
    setInterval(() => {

      if(!gameRunning) return;

      const next =
        getNextPosition(botPos);

      if(next === null){

        /*
         Should rarely happen because
         board has a guaranteed route.
        */

        return;

      }

      botPos = next;

      renderBoard();

      if(botPos === finishPos){

        finishGame(false);

      }

    },delay);

}

function stopBot(){

  if(botInterval){

    clearInterval(botInterval);

    botInterval = null;

  }

}

/* =========================
   TIMER
========================= */

function startTimer(){

  stopTimer();

  startTime =
    Date.now();

  timerInterval =
    setInterval(() => {

      if(!gameRunning) return;

      elapsed =
        Date.now() - startTime;

      $("timer").textContent =
        formatTime(elapsed);

    },100);

}

function stopTimer(){

  if(timerInterval){

    clearInterval(timerInterval);

    timerInterval = null;

  }

}

function stopGameTimers(){

  stopTimer();

  stopBot();

  gameRunning = false;

}

function formatTime(ms){

  const seconds =
    Math.floor(ms/1000);

  const minutes =
    Math.floor(seconds/60);

  const secs =
    seconds % 60;

  return (
    String(minutes).padStart(2,"0") +
    ":" +
    String(secs).padStart(2,"0")
  );

}

/* =========================
   FINISH
========================= */

function finishGame(playerWon){

  if(!gameRunning) return;

  gameRunning = false;

  stopTimer();

  stopBot();

  if(playerWon){

    /*
     Bonus based on speed.
    */

    const timeSeconds =
      elapsed / 1000;

    const speedBonus =
      Math.max(
        0,
        Math.round(
          1000 -
          timeSeconds * 15
        )
      );

    score +=
      speedBonus +
      currentLevel * 100;

    $("score").textContent =
      score;

    wins =
      (saveData.wins || 0) + 1;

    saveData.wins =
      wins;

    if(score > (saveData.best || 0)){

      saveData.best =
        score;

    }

    const oldBest =
      saveData.levelBest[currentLevel] || 0;

    if(score > oldBest){

      saveData.levelBest[currentLevel] =
        score;

    }

    /*
     Unlock next level.
    */

    if(
      currentLevel >=
      (saveData.unlocked || 1)
    ){

      saveData.unlocked =
        Math.min(
          10,
          currentLevel + 1
        );

    }

    save();

    $("resultTitle").textContent =
      "YOU WIN! 🏆";

    $("resultText").textContent =
      "You reached the finish in " +
      formatTime(elapsed) +
      ".";

    $("resultScore").textContent =
      score;

  }else{

    $("resultTitle").textContent =
      mode === "practice"
      ? "FINISHED!"
      : "BOT WINS 🤖";

    $("resultText").textContent =
      mode === "practice"
      ? "You completed the race."
      : "The opponent reached the finish first.";

    $("resultScore").textContent =
      score;

  }

  $("resultModal").classList.remove("hidden");

}

/* =========================
   NEXT LEVEL
========================= */

function nextLevel(){

  $("resultModal").classList.add("hidden");

  if(
    saveData.unlocked &&
    currentLevel < saveData.unlocked
  ){

    startGame(
      currentLevel + 1
    );

  }else{

    showLevels();

  }

}

/* =========================
   RESTART / EXIT
========================= */

function restartGame(){

  $("resultModal").classList.add("hidden");

  startGame(currentLevel);

}

function exitGame(){

  $("resultModal").classList.add("hidden");

  stopGameTimers();

  showLevels();

}

/* =========================
   KEYBOARD
========================= */

document.addEventListener(
  "keydown",
  function(e){

    if(
      $("gameScreen").classList.contains("hidden")
    ){
      return;
    }

    if(e.key === "ArrowUp"){
      e.preventDefault();
      move("up");
    }

    if(e.key === "ArrowRight"){
      e.preventDefault();
      move("right");
    }

    if(e.key === "ArrowDown"){
      e.preventDefault();
      move("down");
    }

    if(e.key === "ArrowLeft"){
      e.preventDefault();
      move("left");
    }

    if(e.key === "Escape"){
      exitGame();
    }

  }
);

/* =========================
   RESIZE
========================= */

window.addEventListener(
  "resize",
  function(){
    positionTokens();
  }
);

/* =========================
   INITIALIZE
========================= */

loadSave();

</script>

