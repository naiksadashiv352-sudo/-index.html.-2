/* =========================================================
   BOARD MATH
   ========================================================= */

const directions = [

  {
    name:"up",
    dx:0,
    dy:-1,
    glyph:"↑"
  },

  {
    name:"right",
    dx:1,
    dy:0,
    glyph:"→"
  },

  {
    name:"down",
    dx:0,
    dy:1,
    glyph:"↓"
  },

  {
    name:"left",
    dx:-1,
    dy:0,
    glyph:"←"
  }

];


function indexFromXY(x,y){

  return y * boardSize + x;

}


function xyFromIndex(index){

  return {

    x:index % boardSize,

    y:Math.floor(index / boardSize)

  };

}


function validDirections(index){

  const p = xyFromIndex(index);

  return directions.filter(d=>{

    const nx = p.x + d.dx;

    const ny = p.y + d.dy;

    return (

      nx >= 0 &&
      nx < boardSize &&
      ny >= 0 &&
      ny < boardSize

    );

  });

}


function neighbor(index,direction){

  const p = xyFromIndex(index);

  const d =
    directions.find(
      x=>x.name===direction
    );

  if(!d) return null;

  const nx = p.x + d.dx;

  const ny = p.y + d.dy;

  if(
    nx < 0 ||
    nx >= boardSize ||
    ny < 0 ||
    ny >= boardSize
  ){

    return null;

  }

  return indexFromXY(nx,ny);

}


/* =========================================================
   LEVEL CONFIG
   ========================================================= */

function getLevelConfig(level){

  return {

    size:levelSizes[level-1],

    timeLimit:
      Math.min(
        240,
        120 + level * 1.2
      ),

    botDelay:
      Math.max(
        165,
        920 - level * 7
      ),

    trapCount:
      level >= 15
      ? Math.min(
          12,
          Math.floor(level/10)
        )
      : 0,

    bonusCount:
      level >= 5
      ? Math.min(
          8,
          1 + Math.floor(level/15)
        )
      : 0,

    teleportCount:
      level >= 30
      ? Math.min(
          6,
          Math.floor(level/20)
        )
      : 0,

    chaos:
      level >= 50,

    boss:
      level % 10 === 0 || level === 100

  };

}


/* =========================================================
   RANDOM HELPERS
   ========================================================= */

function randomInt(min,max){

  return Math.floor(
    Math.random()*(max-min+1)
  ) + min;

}


function shuffle(array){

  for(
    let i=array.length-1;
    i>0;
    i--
  ){

    const j =
      Math.floor(
        Math.random()*(i+1)
      );

    [array[i],array[j]] =
      [array[j],array[i]];

  }

  return array;

}


/* =========================================================
   GENERATE BOARD
   ========================================================= */

function generateBoard(){

  const config =
    getLevelConfig(currentLevel);

  boardSize = config.size;

  const total =
    boardSize * boardSize;

  boardData =
    new Array(total);

  const target =
    total - 1;


  /*
    First create random legal arrows.
  */

  for(let i=0;i<total;i++){

    const dirs =
      validDirections(i);

    const random =
      dirs[
        Math.floor(
          Math.random()*dirs.length
        )
      ];

    boardData[i] =
      random.name;

  }


  /*
    Create a guaranteed route.
  */

  let current = 0;

  const path = [0];

  const visited =
    new Set([0]);


  let attempts = 0;


  while(
    current !== target &&
    attempts < 5000
  ){

    attempts++;


    let choices =
      validDirections(current)
      .filter(d=>{

        const n =
          neighbor(
            current,
            d.name
          );

        return !visited.has(n);

      });


    if(!choices.length){

      current = 0;

      path.length = 1;

      visited.clear();

      visited.add(0);

      continue;

    }


    /*
      Prefer moving towards the target,
      but occasionally make a strange turn.
    */

    shuffle(choices);


    choices.sort((a,b)=>{

      const na =
        neighbor(
          current,
          a.name
        );

      const nb =
        neighbor(
          current,
          b.name
        );


      const pa =
        xyFromIndex(na);

      const pb =
        xyFromIndex(nb);


      const tx =
        boardSize-1;

      const ty =
        boardSize-1;


      const da =
        Math.abs(tx-pa.x) +
        Math.abs(ty-pa.y);

      const db =
        Math.abs(tx-pb.x) +
        Math.abs(ty-pb.y);


      return da-db;

    });


    const chosen =
      Math.random() < .78
      ? choices[0]
      : choices[
          Math.floor(
            Math.random()*choices.length
          )
        ];


    boardData[current] =
      chosen.name;


    current =
      neighbor(
        current,
        chosen.name
      );


    path.push(current);

    visited.add(current);

  }


  /*
    Make absolutely sure the final
    route reaches the finish.
  */

  if(path.length >= 2){

    const before =
      path[path.length-2];

    const finalDirection =
      validDirections(before)
      .find(d=>
        neighbor(
          before,
          d.name
        ) === target
      );


    if(finalDirection){

      boardData[before] =
        finalDirection.name;

    }

  }


  finishPos = target;

  playerPos = 0;

  botPos = 0;


  createSpecialTiles();

}


/* =========================================================
   SPECIAL TILES
   ========================================================= */

function createSpecialTiles(){

  specialTiles = {

    bonus:new Set(),

    trap:new Set(),

    teleport:new Map()

  };


  const config =
    getLevelConfig(currentLevel);

  const total =
    boardSize*boardSize;


  const forbidden =
    new Set([
      0,
      finishPos
    ]);


  /*
    Bonus tiles
  */

  let attempts = 0;

  while(
    specialTiles.bonus.size <
      config.bonusCount &&
    attempts < 500
  ){

    attempts++;

    const pos =
      randomInt(1,total-2);

    if(
      forbidden.has(pos) ||
      specialTiles.trap.has(pos)
    ){

      continue;

    }

    specialTiles.bonus.add(pos);

  }


  /*
    Trap tiles
  */

  attempts = 0;

  while(
    specialTiles.trap.size <
      config.trapCount &&
    attempts < 1000
  ){

    attempts++;

    const pos =
      randomInt(1,total-2);

    if(
      forbidden.has(pos) ||
      specialTiles.bonus.has(pos)
    ){

      continue;

    }

    specialTiles.trap.add(pos);

  }


  /*
    Teleport pairs
  */

  if(config.teleportCount > 0){

    const candidates = [];

    for(let i=1;i<total-1;i++){

      if(
        !forbidden.has(i) &&
        !specialTiles.bonus.has(i) &&
        !specialTiles.trap.has(i)
      ){

        candidates.push(i);

      }

    }


    shuffle(candidates);


    const pairCount =
      Math.min(
        config.teleportCount,
        Math.floor(candidates.length/2)
      );


    for(
      let i=0;
      i<pairCount*2;
      i+=2
    ){

      const a = candidates[i];

      const b = candidates[i+1];

      specialTiles.teleport.set(a,b);

      specialTiles.teleport.set(b,a);

    }

  }

}


