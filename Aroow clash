<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<meta name="theme-color" content="#0b0d12">
<meta name="apple-mobile-web-app-capable" content="yes">

<title>Arrow Clash</title>

<style>
:root{
  --bg:#090b10;
  --panel:#11151d;
  --panel2:#171c26;
  --text:#f5f7fb;
  --muted:#8992a3;
  --accent:#6c63ff;
  --accent2:#9b94ff;
  --green:#25d695;
  --red:#ff5263;
  --yellow:#ffc857;
  --blue:#42b8ff;
  --border:rgba(255,255,255,.09);
  --shadow:0 20px 60px rgba(0,0,0,.45);
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  padding:0;
  width:100%;
  min-height:100%;
  background:
    radial-gradient(circle at top,#191c35 0,#090b10 45%);
  color:var(--text);
  font-family:
    Inter,system-ui,-apple-system,BlinkMacSystemFont,
    "Segoe UI",sans-serif;
}

body{
  min-height:100vh;
  overflow-x:hidden;
}

button{
  font:inherit;
  color:inherit;
  cursor:pointer;
}

.hidden{
  display:none!important;
}

.app{
  width:min(1100px,100%);
  margin:auto;
  min-height:100vh;
  padding:18px;
}

/* HEADER */

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:22px;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:900;
  font-size:22px;
  letter-spacing:-.7px;
}

.logo-icon{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  border-radius:12px;
  background:linear-gradient(135deg,var(--accent),#3c9cff);
  box-shadow:0 10px 30px rgba(108,99,255,.35);
  font-size:22px;
}

.top-best{
  color:var(--muted);
  font-size:13px;
}

.top-best strong{
  color:var(--yellow);
}

/* SCREENS */

.screen{
  animation:fadeIn .25s ease;
}

@keyframes fadeIn{
  from{
    opacity:0;
    transform:translateY(8px);
  }
  to{
    opacity:1;
    transform:none;
  }
}

/* HOME */

.hero{
  padding:45px 10px 30px;
  text-align:center;
}

.hero h1{
  margin:0;
  font-size:clamp(45px,10vw,82px);
  line-height:.95;
  letter-spacing:-5px;
  background:linear-gradient(135deg,#fff,#8f8aff,#43b8ff);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero p{
  color:var(--muted);
  max-width:600px;
  margin:20px auto 28px;
  line-height:1.6;
}

.primary-btn{
  border:0;
  border-radius:16px;
  padding:16px 28px;
  background:linear-gradient(135deg,var(--accent),#397dff);
  font-weight:900;
  box-shadow:0 15px 40px rgba(81,84,255,.28);
  transition:.2s;
}

.primary-btn:hover{
  transform:translateY(-2px);
}

.primary-btn:active{
  transform:scale(.97);
}

.secondary-btn{
  border:1px solid var(--border);
  background:var(--panel);
  border-radius:14px;
  padding:13px 20px;
  font-weight:800;
}

.home-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
}

.stats{
  margin:35px auto 0;
  max-width:720px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.stat{
  background:rgba(17,21,29,.85);
  border:1px solid var(--border);
  border-radius:18px;
  padding:20px;
}

.stat strong{
  display:block;
  font-size:25px;
  margin-bottom:5px;
}

.stat span{
  color:var(--muted);
  font-size:12px;
}

/* LEVEL SCREEN */

.section-title{
  text-align:center;
  margin:25px 0;
}

.section-title h2{
  margin:0 0 7px;
  font-size:32px;
}

.section-title p{
  margin:0;
  color:var(--muted);
}

.mode-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-bottom:20px;
}

.mode{
  border:1px solid var(--border);
  background:var(--panel);
  border-radius:18px;
  padding:17px;
  text-align:left;
  transition:.2s;
}

.mode.active{
  border-color:var(--accent);
  background:rgba(108,99,255,.14);
}

.mode strong{
  display:block;
  margin-bottom:5px;
}

.mode span{
  color:var(--muted);
  font-size:12px;
}

.level-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:10px;
}

.level{
  min-height:115px;
  text-align:left;
  padding:13px;
  border:1px solid var(--border);
  background:var(--panel);
  border-radius:16px;
  transition:.2s;
}

.level:hover:not(.locked){
  transform:translateY(-2px);
  border-color:var(--accent);
}

.level.locked{
  opacity:.42;
  cursor:not-allowed;
}

.level-number{
  display:block;
  font-size:11px;
  font-weight:900;
  color:var(--accent2);
}

.level-name{
  display:block;
  margin:7px 0;
  font-size:14px;
  font-weight:900;
}

.level-challenge{
  display:block;
  color:var(--muted);
  font-size:10px;
  line-height:1.35;
}

.level-best{
  display:block;
  margin-top:9px;
  color:var(--yellow);
  font-size:10px;
}

/* GAME */

.game-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:12px;
}

.game-head-left{
  display:flex;
  align-items:center;
  gap:8px;
}

.icon-btn{
  width:42px;
  height:42px;
  border:1px solid var(--border);
  background:var(--panel);
  border-radius:13px;
}

.game-title{
  font-size:14px;
  font-weight:900;
}

.game-sub{
  color:var(--muted);
  font-size:11px;
}

.hud{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:9px;
  margin-bottom:12px;
}

.hud-item{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:15px;
  padding:11px;
  text-align:center;
}

.hud-item small{
  display:block;
  color:var(--muted);
  font-size:9px;
  font-weight:800;
  margin-bottom:4px;
}

.hud-item strong{
  font-size:17px;
}

.race-bar{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:12px;
}

.racer{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:14px;
  padding:10px 13px;
}

.racer-top{
  display:flex;
  justify-content:space-between;
  font-size:12px;
  font-weight:900;
}

.racer-status{
  color:var(--muted);
  font-size:10px;
  margin-top:4px;
}

.racer.player{
  border-color:rgba(108,99,255,.5);
}

.racer.bot{
  border-color:rgba(255,82,99,.4);
}

/* CHALLENGE */

.challenge{
  margin-bottom:12px;
  background:linear-gradient(
    135deg,
    rgba(108,99,255,.15),
    rgba(66,184,255,.08)
  );
  border:1px solid rgba(108,99,255,.25);
  border-radius:14px;
  padding:11px 13px;
}

.challenge strong{
  font-size:12px;
}

.challenge span{
  color:var(--muted);
  font-size:10px;
  display:block;
  margin-top:3px;
}

/* BOARD */

.board-wrap{
  display:flex;
  justify-content:center;
  margin:8px 0;
}

.board{
  --size:5;
  width:min(86vw,640px);
  aspect-ratio:1;
  display:grid;
  grid-template-columns:repeat(var(--size),1fr);
  gap:5px;
  padding:7px;
  background:#07090d;
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:var(--shadow);
}

.cell{
  position:relative;
  min-width:0;
  min-height:0;
  border:1px solid rgba(255,255,255,.055);
  background:#151a23;
  border-radius:9px;
  display:grid;
  place-items:center;
  user-select:none;
}

.arrow{
  font-size:clamp(16px,4vw,31px);
  color:#cdd3df;
  font-weight:900;
}

.cell.current{
  background:rgba(108,99,255,.22);
  border-color:rgba(108,99,255,.65);
  box-shadow:inset 0 0 20px rgba(108,99,255,.12);
}

.cell.finish{
  background:rgba(37,214,149,.12);
  border-color:rgba(37,214,149,.5);
}

.cell.special-bonus{
  background:rgba(255,200,87,.13);
  border-color:rgba(255,200,87,.55);
}

.cell.special-trap{
  background:rgba(255,82,99,.12);
  border-color:rgba(255,82,99,.55);
}

.cell.special-teleport{
  background:rgba(66,184,255,.12);
  border-color:rgba(66,184,255,.55);
}

.marker{
  position:absolute;
  bottom:3px;
  right:4px;
  font-size:9px;
}

.player-marker{
  position:absolute;
  width:34%;
  height:34%;
  min-width:15px;
  min-height:15px;
  border-radius:50%;
  background:var(--accent);
  border:2px solid #fff;
  box-shadow:0 0 20px rgba(108,99,255,.8);
  z-index:5;
}

.bot-marker{
  position:absolute;
  width:25%;
  height:25%;
  min-width:12px;
  min-height:12px;
  border-radius:50%;
  background:var(--red);
  border:2px solid #fff;
  box-shadow:0 0 15px rgba(255,82,99,.7);
  z-index:4;
}

.message{
  min-height:44px;
  text-align:center;
  color:var(--muted);
  font-size:12px;
  padding:9px;
}

.controls{
  display:grid;
  grid-template-columns:repeat(3,58px);
  justify-content:center;
  gap:7px;
  margin-top:5px;
}

.control{
  width:58px;
  height:50px;
  border:1px solid var(--border);
  border-radius:13px;
  background:var(--panel);
  font-size:20px;
  font-weight:900;
}

.control:active{
  transform:scale(.94);
  background:var(--panel2);
}

.control.up{
  grid-column:2;
}

.control.left{
  grid-column:1;
  grid-row:2;
}

.control.down{
  grid-column:2;
  grid-row:2;
}

.control.right{
  grid-column:3;
  grid-row:2;
}

.game-actions{
  display:flex;
  justify-content:center;
  gap:9px;
  margin-top:14px;
}

/* MODAL */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(8px);
  display:grid;
  place-items:center;
  padding:18px;
  z-index:100;
}

.modal{
  width:min(500px,100%);
  background:#11151d;
  border:1px solid var(--border);
  border-radius:24px;
  padding:28px;
  text-align:center;
  box-shadow:var(--shadow);
}

.modal-icon{
  font-size:50px;
}

.modal h2{
  margin:10px 0 7px;
  font-size:30px;
}

.modal p{
  color:var(--muted);
  line-height:1.55;
}

.result-score{
  font-size:35px;
  font-weight:900;
  color:var(--yellow);
  margin:15px;
}

.modal-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:9px;
  margin-top:18px;
}

/* TOAST */

.toast{
  position:fixed;
  left:50%;
  bottom:25px;
  transform:translateX(-50%) translateY(20px);
  opacity:0;
  pointer-events:none;
  background:#f5f7fb;
  color:#080a0e;
  padding:11px 16px;
  border-radius:13px;
  font-size:12px;
  font-weight:900;
  z-index:200;
  transition:.25s;
}

.toast.show{
  opacity:1;
  transform:translateX(-50%) translateY(0);
}

/* RESPONSIVE */

@media(max-width:700px){
  .app{
    padding:12px;
  }

  .hero{
    padding-top:35px;
  }

  .stats{
    grid-template-columns:1fr 1fr 1fr;
  }

  .mode-grid{
    grid-template-columns:1fr;
  }

  .level-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .hud{
    grid-template-columns:repeat(2,1fr);
  }

  .race-bar{
    grid-template-columns:1fr 1fr;
  }

  .board{
    width:94vw;
    gap:3px;
    padding:5px;
  }
}

@media(max-width:380px){
  .level-grid{
    grid-template-columns:1fr 1fr;
  }

  .race-bar{
    grid-template-columns:1fr;
  }

  .controls{
    grid-template-columns:52px 52px 52px;
  }

  .control{
    width:52px;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- TOP BAR -->

  <header class="topbar">
    <div class="logo">
      <div class="logo-icon">➤</div>
      <span>ARROW CLASH</span>
    </div>

    <div class="top-best">
      BEST <strong id="topBest">0</strong>
    </div>
  </header>


  <!-- HOME -->

  <main id="homeScreen" class="screen">

    <section class="hero">

      <h1>ARROW<br>CLASH</h1>

      <p>
        Follow the arrows, think fast and reach the goal.
        Every level gets harder. Can you survive all
        <strong>100 challenges?</strong>
      </p>

      <div class="home-actions">
        <button class="primary-btn" id="playNow">
          PLAY NOW ⚡
        </button>

        <button class="secondary-btn" id="howBtn">
          HOW TO PLAY
        </button>
      </div>

      <div class="stats">

        <div class="stat">
          <strong id="homeLevel">1</strong>
