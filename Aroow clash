   ========================================================= */

const levelSizes = [];

for(let i = 1; i <= 100; i++){

  if(i <= 10){
    levelSizes.push(5);
  }
  else if(i <= 20){
    levelSizes.push(6);
  }
  else if(i <= 40){
    levelSizes.push(7);
  }
  else if(i <= 60){
    levelSizes.push(8);
  }
  else if(i <= 80){
    levelSizes.push(9);
  }
  else if(i <= 95){
    levelSizes.push(10);
  }
  else{
    levelSizes.push(11);
  }

}


