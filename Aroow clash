/* =========================================================
   RENDER BOARD
   ========================================================= */

function renderBoard(){

  boardElement.innerHTML = "";

  boardElement.style.setProperty(
    "--size",
    boardSize
  );


  for(let i=0;i<boardData.length;i++){

    const cell =
      document.createElement("div");

    cell.className = "cell";


    if(i === playerPos){

      cell.classList.add("current");

    }


    if(i === finishPos){

      cell.classList.add("finish");

    }


    if(
      specialTiles.bonus.has(i)
    ){

      cell.classList.add("special-bonus");

    }


    if(
      specialTiles.trap.has(i)
    ){

      cell.classList.add("special-trap");

    }


    if(
      specialTiles.teleport.has(i)
    ){

      cell.classList.add("special-teleport");

    }


    const arrow =
      document.createElement("span");

    arrow.className = "arrow";


    const direction =
      directions.find(
        d=>d.name===boardData[i]
      );


    arrow.textContent =
      direction
        ? direction.glyph
        : "•";


    cell.appendChild(arrow);


    /*
      Special icon
    */

    if(specialTiles.bonus.has(i)){

      const marker =
        document.createElement("span");

      marker.className = "marker";

      marker.textContent = "⭐";

      cell.appendChild(marker);

    }


    if(specialTiles.trap.has(i)){

      const marker =
        document.createElement("span");

      marker.className = "marker";

      marker.textContent = "💥";

      cell.appendChild(marker);

    }


    if(
      specialTiles.teleport.has(i)
    ){

      const marker =
        document.createElement("span");

      marker.className = "marker";

      marker.textContent = "🌀";

      cell.appendChild(marker);

    }


    /*
      Player
    */

    if(i === playerPos){

      const marker =
        document.createElement("div");

      marker.className =
        "player-marker";

      cell.appendChild(marker);

    }


    /*
      Bot
    */

    if(
      mode === "bot" &&
      i === botPos &&
      botPos !== playerPos
    ){

      const marker =
        document.createElement("div");

      marker.className =
        "bot-marker";

      cell.appendChild(marker);

    }


    boardElement.appendChild(cell);

  }


  $("playerPosText").textContent =
    playerPos === finishPos
      ? "GOAL"
      : String(playerPos+1);


  $("botPosText").textContent =
    mode === "practice"
      ? "-"
      : botPos === finishPos
        ? "GOAL"
        : String(botPos+1);

}


/* =========================================================
   PLAYER MOVEMENT
   ========================================================= */

function movePlayer(direction){

  if(!gameRunning){

    return;

  }


  const allowed =
    boardData[playerPos];


  /*
    Player must follow the arrow.
  */

  if(direction !== allowed){

    combo = 0;

    $("combo").textContent = "0";

    score =
      Math.max(
        0,
        score-10
      );


    $("score").textContent =
      score;


    $("message").textContent =
      "❌ Wrong direction! Follow the arrow.";

    showToast("-10  Wrong direction");

    return;

  }


  const next =
    neighbor(
      playerPos,
      direction
    );


  if(next === null){

    combo = 0;

    $("message").textContent =
      "🚧 You cannot move outside the board.";

    return;

  }


  playerPos = next;

  combo++;


  /*
    Base movement score
  */

  score +=
    10 +
    Math.min(
      50,
      combo*2
    );


  /*
    Bonus
  */

  if(
    specialTiles.bonus.has(playerPos)
  ){

    score += 250;

    showToast(
      "⭐ BONUS +250"
    );

  }


  /*
    Trap
  */

  if(
    specialTiles.trap.has(playerPos)
  ){

    score =
      Math.max(
        0,
        score-150
      );

    combo = 0;

    showToast(
      "💥 TRAP -150"
    );

  }


  /*
    Teleport
  */

  if(
    specialTiles.teleport.has(playerPos)
  ){

    const destination =
      specialTiles.teleport.get(
        playerPos
      );


    playerPos = destination;


    score += 100;


    showToast(
      "🌀 TELEPORT +100"
    );

  }


  $("score").textContent =
    score;


  $("combo").textContent =
    combo;


  $("message").textContent =
    combo >= 5
      ? "🔥 COMBO! Keep going!"
      : "Good move! Follow the next arrow.";


  renderBoard();


  /*
    Finish
  */

  if(playerPos === finishPos){

    finishGame("player");

    return;

  }


  /*
    Local two-player mode.
  */

  if(mode === "local"){

    localPlayer =
      localPlayer === 1
      ? 2
      : 1;


    if(localPlayer === 2){

      $("message").textContent =
        "🟠 Player 2's turn";

    }
    else{

      $("message").textContent =
        "🔵 Player 1's turn";

    }

  }

}


/* =========================================================
   BOT
   ========================================================= */

function startBot(){

  clearTimeout(botTimeout);


  function botMove(){

    if(!gameRunning){

      return;

    }


    const direction =
      boardData[botPos];


    const next =
      neighbor(
        botPos,
        direction
      );


    if(next !== null){

      botPos = next;

    }


    /*
      Bot gets affected by some
      special tiles too.
    */

    if(
      specialTiles.teleport.has(botPos)
    ){

      botPos =
        specialTiles.teleport.get(
          botPos
        );

    }


    renderBoard();


    if(botPos === finishPos){

      if(playerPos !== finishPos){

        finishGame("bot");

        return;

      }

    }


    const config =
      getLevelConfig(currentLevel);


    let delay =
      config.botDelay;


    /*
      Boss levels are faster.
    */

    if(config.boss){

      delay -= 60;

    }


    /*
      Level 100 is extremely fast.
    */

    if(currentLevel === 100){

      delay = 115;

    }


    /*
      Small random reaction difference.
    */

    delay +=
      randomInt(-25,35);


    botTimeout =
      setTimeout(
        botMove,
        Math.max(100,delay)
      );

  }


  botTimeout =
    setTimeout(
      botMove,
      700
    );

}


/* =========================================================
   TIMER
   ========================================================= */

function startTimer(){

  clearInterval(timerInterval);


  timerInterval =
    setInterval(()=>{

      if(!gameRunning){

        return;

      }


      elapsed++;


      const minutes =
        Math.floor(elapsed/60);

      const seconds =
        elapsed%60;


      $("timer").textContent =
        String(minutes).padStart(2,"0") +
        ":" +
        String(seconds).padStart(2,"0");


      const config =
        getLevelConfig(currentLevel);


      /*
        Time warning.
      */

      if(
        config.timeLimit-elapsed <= 20 &&
        config.timeLimit-elapsed > 0
      ){

        $("message").textContent =
          "⏱️ Hurry! Time is running out!";

      }


      /*
        Time limit.
      */

      if(elapsed >= config.timeLimit){

        finishGame("timeout");

      }

    },1000);

}


/* =========================================================
   FINISH GAME
   ========================================================= */

function finishGame(winner){

  if(!gameRunning){

    return;

  }


  gameRunning = false;

  clearInterval(timerInterval);

  clearTimeout(botTimeout);


  /*
    Player win
  */

  if(winner === "player"){

    const speedBonus =
      Math.max(
        0,
        Math.round(
          1000 -
          elapsed*12
        )
      );


    const levelBonus =
      currentLevel*100;


    const comboBonus =
      combo*25;


    let finalScore =
      score +
      speedBonus +
      levelBonus +
      comboBonus;


    /*
      Level 100 special bonus.
    */

    if(currentLevel === 100){

      finalScore += 10000;

    }


    score = finalScore;


    saveData.wins =
      (saveData.wins || 0)+1;


    if(score > (saveData.best || 0)){

      saveData.best = score;

    }


    const previousBest =
      saveData.levelBest[currentLevel] || 0;


    if(score > previousBest){

      saveData.levelBest[currentLevel] =
        score;

    }


    /*
      Unlock next level.
    */

    if(
      currentLevel >=
      (saveData.unlocked || 1)
    ){

      saveData.unlocked =
        Math.min(
          100,
          currentLevel+1
        );

    }


    save();


    if(currentLevel === 100){

      $("resultIcon").textContent =
        "👑";

      $("resultTitle").textContent =
        "YOU BEAT 100 LEVELS!";

      $("resultText").textContent =
        "You are the ultimate Arrow Clash champion!";

      $("resultScore").textContent =
        "+" + score;

      $("nextLevelBtn").classList.add(
        "hidden"
      );

    }
    else{

      $("resultIcon").textContent =
        "🏆";

      $("resultTitle").textContent =
        "YOU WIN!";

      $("resultText").textContent =
        "Level " +
        currentLevel +
        " completed. Next challenge unlocked.";

      $("resultScore").textContent =
        "+" + score;

      $("nextLevelBtn").classList.remove(
        "hidden"
      );

    }


    showResult();

  }


  /*
    Bot win
  */

  else if(winner === "bot"){

    $("resultIcon").textContent =
      "🤖";

    $("resultTitle").textContent =
      "BOT WINS";

    $("resultText").textContent =
      "The bot reached the goal first. Try again!";

    $("resultScore").textContent =
      score;


    $("nextLevelBtn").classList.add(
      "hidden"
    );


    showResult();

  }


  /*
    Time out
  */

  else{

    $("resultIcon").textContent =
      "⏱️";

    $("resultTitle").textContent =
      "TIME UP!";

    $("resultText").textContent =
      "The clock beat you. Try the level again.";

    $("resultScore").textContent =
      score;


    $("nextLevelBtn").classList.add(
      "hidden"
    );


    showResult();

  }

}


/* =========================================================
   RESULT
   ========================================================= */

function showResult(){

  resultOverlay.classList.remove(
    "hidden"
  );

}


function closeResult(){

  resultOverlay.classList.add(
    "hidden"
  );

}


/* =========================================================
   STOP GAME
   ========================================================= */

function stopGame(){

  gameRunning = false;

  clearInterval(timerInterval);

  clearTimeout(botTimeout);

}


/* =========================================================
   NEXT LEVEL
   ========================================================= */

$("nextLevelBtn").addEventListener(
  "click",
  ()=>{

    closeResult();

    const next =
      currentLevel+1;


    if(next <= 100){

      startGame(next);

    }
    else{

      showLevels();

    }

