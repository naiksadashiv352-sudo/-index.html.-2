        </div>

        <div class="stat">
          <strong id="homeWins">0</strong>
          <span>WINS</span>
        </div>

        <div class="stat">
          <strong id="homeScore">0</strong>
          <span>BEST SCORE</span>
        </div>

      </div>

    </section>

  </main>


  <!-- LEVEL SCREEN -->

  <main id="levelsScreen" class="screen hidden">

    <div class="section-title">
      <h2>Choose Your Challenge</h2>
      <p>100 levels. Increasing difficulty. One final clash.</p>
    </div>

    <div class="mode-grid">

      <button class="mode active" data-mode="bot">
        <strong>🤖 VS BOT</strong>
        <span>Race against the computer.</span>
      </button>

      <button class="mode" data-mode="local">
        <strong>👥 2 PLAYERS</strong>
        <span>Take turns with a friend.</span>
      </button>

      <button class="mode" data-mode="practice">
        <strong>🧠 PRACTICE</strong>
        <span>Train without an opponent.</span>
      </button>

    </div>

    <div id="levelGrid" class="level-grid"></div>

  </main>


  <!-- GAME SCREEN -->

  <main id="gameScreen" class="screen hidden">

    <div class="game-head">

      <div class="game-head-left">

        <button class="icon-btn" id="exitGame">
          ←
        </button>

        <div>
          <div class="game-title">
            ARROW CLASH
          </div>

          <div class="game-sub">
            LEVEL <span id="levelDisplay">1</span>
          </div>
        </div>

      </div>

      <button class="secondary-btn" id="restartGame">
        ↻
      </button>

    </div>


    <div class="hud">

      <div class="hud-item">
        <small>TIME</small>
        <strong id="timer">00:00</strong>
      </div>

      <div class="hud-item">
        <small>SCORE</small>
        <strong id="score">0</strong>
      </div>

      <div class="hud-item">
        <small>COMBO</small>
        <strong id="combo">0</strong>
      </div>

      <div class="hud-item">
        <small>BEST</small>
        <strong id="gameBest">0</strong>
      </div>

    </div>


    <div class="challenge">

      <strong id="challengeTitle">
        FIRST STEPS
      </strong>

      <span id="challengeText">
        Follow the arrows and reach the green goal.
      </span>

    </div>


    <div class="race-bar">

      <div class="racer player">

        <div class="racer-top">
          <span>🔵 YOU</span>
          <span id="playerPosText">START</span>
        </div>

        <div class="racer-status" id="playerStatus">
          Your turn
        </div>

      </div>


      <div class="racer bot">

        <div class="racer-top">
          <span id="opponentName">🤖 BOT</span>
          <span id="botPosText">START</span>
        </div>

        <div class="racer-status" id="opponentStatus">
          Racing
        </div>

      </div>

    </div>


    <div class="board-wrap">
      <div id="board" class="board"></div>
    </div>


    <div id="message" class="message">
      Follow the arrow from your current tile.
    </div>


    <div class="controls">

      <button class="control up" data-dir="up">
        ↑
      </button>

      <button class="control left" data-dir="left">
        ←
      </button>

      <button class="control down" data-dir="down">
        ↓
      </button>

      <button class="control right" data-dir="right">
        →
      </button>

    </div>


    <div class="game-actions">

      <button class="secondary-btn" id="restartGame2">
        RESTART
      </button>

      <button class="secondary-btn" id="exitGame2">
        EXIT
      </button>

    </div>

  </main>

</div>


<!-- RESULT MODAL -->

<div id="resultOverlay" class="overlay hidden">

  <div class="modal">

    <div class="modal-icon" id="resultIcon">
      🏆
    </div>

    <h2 id="resultTitle">
      YOU WIN!
    </h2>

    <p id="resultText">
      Great job!
    </p>

    <div class="result-score" id="resultScore">
      +100
    </div>

    <div class="modal-actions">

      <button class="primary-btn" id="nextLevelBtn">
        NEXT LEVEL →
      </button>

      <button class="secondary-btn" id="levelSelectBtn">
        LEVEL SELECT
      </button>

    </div>

  </div>

</div>


<!-- HOW TO PLAY -->

<div id="howOverlay" class="overlay hidden">

  <div class="modal">

    <div class="modal-icon">🧠</div>

    <h2>HOW TO PLAY</h2>

    <p>
      Start from the first tile.
      Look at the arrow on your current tile.
      Move in the direction of the arrow.
    </p>

    <p>
      🟢 Reach the green goal.<br>
      🟡 Bonus tiles give extra points.<br>
      🔴 Trap tiles punish mistakes.<br>
      🔵 Teleport tiles can move you forward.
    </p>

    <p>
      Later levels become faster and more difficult.
      Finish quickly to earn a bigger score.
    </p>

    <button class="primary-btn" id="closeHow">
      GOT IT
    </button>

  </div>

</div>


<div id="toast" class="toast"></div>


