function updateCountdown() {
  if (!game) return;
  const number=Math.max(1,Math.ceil((3000-game.countdown)/1000));
  if (number!==countdownNumber) {
    countdownNumber=number;
    $('countdown-number').textContent=number;
    sound('countdown');
  }
