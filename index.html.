    if (event.detail===0&&game) {
      const id=Number(button.dataset.racer);
      humanMove(id,nextCell(game.board,game.racers[id].pos,Number(button.dataset.dir)));
    }
    return;
  }

  sound('tap');
  if (button.dataset.mode) {
    save.settings.mode=button.dataset.mode;
    persist(); updateHome(); return;
  }
  if (button.dataset.difficulty) {
    save.settings.difficulty=button.dataset.difficulty;
    persist();
    document.querySelectorAll('[data-difficulty]').forEach(b=>{
      const active=b.dataset.difficulty===save.settings.difficulty;
      b.classList.toggle('selected',active);
      b.setAttribute('aria-pressed',String(active));
    });
    return;
  }
  if (button.dataset.level) {
    startGame(Number(button.dataset.level)); return;
  }
  if (button.hasAttribute('data-player')) {
    if (game&&game.mode==='local') {
      game.active=Number(button.dataset.player);
      paintBoard(); updateHUD();
    }
    return;
  }

  switch (button.dataset.action) {
    case 'play': startGame(save.unlocked); break;
    case 'levels': goLevels(); break;
    case 'home': goHome(); break;
    case 'settings': showSettings(); break;
    case 'help': showHelp(); break;
    case 'close': closeModal(); break;
    case 'back': pauseRace('leave'); break;
    case 'pause': pauseRace(); break;
    case 'resume': resumeRace(); break;
    case 'hint': useHint(); break;
    case 'restart': if (game) startGame(game.level,game.seed); break;
    case 'next':
      if (game&&game.level<10) startGame(game.level+1);
      else goLevels();
      break;
  }
});
document.addEventListener('change',event=>{
  if (event.target.id==='sound-setting') {
    save.settings.sound=event.target.checked;
    persist();
    if (save.settings.sound) { unlockAudio(); sound('correct'); }
  } else if (event.target.id==='motion-setting') {
    save.settings.reduced=event.target.checked;
    persist(); applyMotion();
  }
});
$('modal').addEventListener('click',event=>{
  if (event.target===$('modal')&&['settings','help'].includes(modalKind)) {
    closeModal();
  }
});
document.addEventListener('keydown',event=>{
  if (!$('modal').hidden) {
    if (event.key==='Escape') {
      if (['settings','help'].includes(modalKind)) closeModal();
      else if (['pause','leave'].includes(modalKind)) resumeRace();
    }
    if (event.key==='Tab') {
      const nodes=Array.from(
        $('modal-card').querySelectorAll('button:not(:disabled),input')
      );
      const first=nodes[0],last=nodes[nodes.length-1];
      if (event.shiftKey&&document.activeElement===first) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey&&document.activeElement===last) {
        event.preventDefault(); first.focus();
      }
    }
    return;
  }
  if (!game||event.repeat||event.altKey||event.ctrlKey||event.metaKey) return;
  if (event.key==='Escape'||event.key.toLowerCase()==='p') {
    event.preventDefault(); pauseRace(); return;
  }
  if (game.phase!=='running') return;
  if (event.key.toLowerCase()==='h') {
    event.preventDefault(); useHint(); return;
  }
  const arrows={ArrowUp:0,ArrowRight:1,ArrowDown:2,ArrowLeft:3};
  const wasd={w:0,d:1,s:2,a:3};
  let dir=arrows[event.key],id=game.mode==='local'?1:0;
  if (dir===undefined) { dir=wasd[event.key.toLowerCase()]; id=0; }
  if (dir!==undefined) {
    event.preventDefault(); unlockAudio();
    humanMove(id,nextCell(game.board,game.racers[id].pos,dir));
  }
});
document.addEventListener('visibilitychange',()=>{
  if (document.hidden) pauseRace();
});
window.addEventListener('pagehide',()=>{
  if (game&&['running','countdown'].includes(game.phase)) pauseRace();
});
if (motionQuery.addEventListener) {
  motionQuery.addEventListener('change',applyMotion);
}
$('board').addEventListener('animationend',()=>{
  $('board').classList.remove('shake');
});

applyMotion(); initializePreview(); updateHome(); showScreen('home');
})();
</script>
  </body>
</html>
      
