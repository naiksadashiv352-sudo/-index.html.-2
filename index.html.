function handleEvent(event) {
  if (!event||!game) return;
  paintBoard(event.target,event.kind,event.id); updateHUD();
  if (event.id===0||game.mode==='local') {
    setStatus(
      (game.mode==='local'?'P'+(event.id+1)+' · ':'')+event.message,
      ['wrong','dead','trap'].includes(event.kind)?'warning'
        :event.kind==='return'?'neutral':'good'
    );
    if (['wrong','dead','trap'].includes(event.kind)) sound('wrong');
    else if (event.kind==='bonus') sound('bonus');
    else if (event.kind!=='return'&&event.kind!=='finish') sound('correct');
  }
  if (game.phase==='ended'&&!game.resultShown) finishRace();
}
function frame(now) {
  frameId=0;
  if (!game) return;
  const before=game.phase,oldHint=game.hint;
  const events=advanceGame(game,Math.max(0,now-lastFrame));
  lastFrame=now;
  if (before==='countdown'&&game.phase==='running') {
    $('countdown').hidden=true;
    setStatus('Go! Follow the arrows on your current tile.','good');
    paintBoard(); sound('correct');
  } else if (game.phase==='countdown') updateCountdown();
  for (const event of events) handleEvent(event);
  if (oldHint&&!game.hint) paintBoard();
  updateHUD();
  if (game&&['running','countdown'].includes(game.phase)) {
    frameId=requestAnimationFrame(frame);
  }
}
function humanMove(id,target) {
  if (!game||game.mode!=='local'&&id!==0) return;
  if (game.mode==='local') game.active=id;
  const event=applyMove(game,id,target);
  handleEvent(event);
  if (!event) updateHUD();
}
function useHint() {
  if (!game||game.phase!=='running') return;
  const r=game.racers[game.active];
  if (!r.hints||game.elapsed<r.lockUntil) return;
  const target=bestNext(game,r);
  if (target<0) return;
  r.hints--; r.hintsUsed++; r.score-=10;
  game.hint={target,until:game.elapsed+2500};
  const dir=game.board.tiles[r.pos].exits
    .find(d=>nextCell(game.board,r.pos,d)===target);
  setStatus((game.mode==='local'?'P'+(game.active+1)+' · ':'')
    +'Hint: move '+DIRS[dir].glyph+' · −10 points.','neutral');
  paintBoard(); updateHUD(); sound('tap');
}
