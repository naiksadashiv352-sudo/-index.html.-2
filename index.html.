function paintBoard(target,kind,id) {
  if (!game) return;
  const b=game.board,players=game.mode==='practice'?1:2;
  const cells=$('board-grid').children;
  Array.from(cells).forEach((cell,i)=>{
    const tile=b.tiles[i],classes=['cell',tile.kind];
    if (i===b.goal) classes.push('goal');
    if (game.racers[0].visited.has(i)) classes.push('visited-red');
    if (players>1&&game.racers[1].visited.has(i)) classes.push('visited-black');
    const red=game.racers[0].pos===i;
    const black=players>1&&game.racers[1].pos===i;
    if (red) classes.push('current-red');
    if (black) classes.push('current-black');
    if (game.hint&&game.hint.target===i) classes.push('hinted');
    if (game.level===1&&game.phase==='running'&&game.mode!=='local'
        &&b.tiles[game.racers[0].pos].exits
          .some(d=>nextCell(b,game.racers[0].pos,d)===i)) {
      classes.push('beginner-next');
    }
    cell.className=classes.join(' ');
    cell.setAttribute('aria-current',String(game.racers[game.active].pos===i));
  });

  if (Number.isInteger(target)&&cells[target]
      &&['correct','bonus','trap','finish'].includes(kind)) {
    cells[target].classList.add('correct-flash');
  }
  if (['wrong','dead','trap'].includes(kind)) {
    $('board').classList.remove('shake');
    void $('board').offsetWidth;
    $('board').classList.add('shake');
  }

  for (let p=0;p<players;p++) {
    const r=game.racers[p],token=$('token-'+(p+1));
    token.style.left=((r.pos%b.n+(p ? .78 : .22))*100/b.n)+'%';
    token.style.top=((Math.floor(r.pos/b.n)+.22)*100/b.n)+'%';
    token.classList.toggle('stunned',
      game.elapsed<r.lockUntil&&r.lockUntil-game.elapsed>150);
    $('trail-'+(p+1)).setAttribute('points',
      r.trail.map(i=>(i%b.n+.5)+','+(Math.floor(i/b.n)+.5)).join(' '));
  }
}
function updateHUD() {
  if (!game) return;
  const b=game.board,id=game.mode==='local'?game.active:0;
  $('timer').textContent=formatTime(game.elapsed);
  $('score').textContent=game.racers[id].score;
  $('game-best').textContent=(save.records[game.level]||{}).best||0;
  $('score-label').textContent=game.mode==='local'?'P'+(id+1)+' SCORE':'SCORE';

  for (let p=0;p<(game.mode==='practice'?1:2);p++) {
    const r=game.racers[p];
    const progress=Math.max(0,Math.min(1,1-b.dist[r.pos]/b.dist[r.start]));
    $('racer-score-'+(p+1)).textContent=r.score+' pts';
    $('racer-arrows-'+(p+1)).textContent=r.pos===b.goal?'FINISH'
      :b.tiles[r.pos].exits.map(d=>DIRS[d].glyph).join(' ');
    $('progress-'+(p+1)).style.width=Math.round(progress*100)+'%';
    $('progress-track-'+(p+1)).setAttribute('aria-valuenow',Math.round(progress*100));
    $('racer-'+(p+1)).classList.toggle('selected',game.active===p);
    $('racer-'+(p+1)).setAttribute('aria-pressed',String(game.active===p));
    if (game.mode==='local') {
      $('pad-state-'+p).textContent=game.elapsed<r.lockUntil?'WAIT':'GO';
    }
  }
  const r=game.racers[id];
  $('hint-count').textContent=r.hints;
  $('hint-button').disabled=game.phase!=='running'||!r.hints||game.elapsed<r.lockUntil;
  document.querySelectorAll('.direction').forEach(button=>{
    const racer=game.racers[Number(button.dataset.racer)];
    button.disabled=game.phase!=='running'||game.elapsed<racer.lockUntil;
  });
  $('token-1').classList.toggle('stunned',
    game.elapsed<game.racers[0].lockUntil&&game.racers[0].lockUntil-game.elapsed>150);
  $('token-2').classList.toggle('stunned',
    game.elapsed<game.racers[1].lockUntil&&game.racers[1].lockUntil-game.elapsed>150);
}
