<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#faf9f7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="description" content="Arrow Clash: an original arrow-path puzzle race. Play against a bot, challenge a friend, or practice your next move.">
<title>Arrow Clash</title>
<style>
:root{
  --red:#dc382f;--red-light:#fff0ed;--ink:#20232c;--muted:#646974;
  --line:#e9e9ed;--gold:#e5a12a;--paper:#faf9f7;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:var(--ink);background:var(--paper);font-synthesis:none;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;overflow-x:hidden;overflow-x:clip;-webkit-tap-highlight-color:transparent}
button,input{font:inherit}
button{cursor:pointer;touch-action:manipulation;-webkit-user-select:none;user-select:none}
button{transition:transform .15s,background .2s,box-shadow .2s}
button:active:not(:disabled){transform:scale(.96)}
button:focus-visible,input:focus-visible{outline:3px solid #346cc7;outline-offset:4px}
button:disabled{cursor:default;opacity:.48}
button svg{pointer-events:none}
h1,h2,p{margin:0}
button{color:inherit}
.ambient{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0;background:radial-gradient(ellipse at 15% 20%,#ffece7 0,transparent 40%),radial-gradient(ellipse at 90% 80%,#eeedf2 0,transparent 42%)}
.ambient span{position:absolute;color:#cdbfbb;font-size:90px;opacity:.12;animation:ambient-drift 13s ease-in-out infinite;animation-delay:var(--delay)}
.ambient span:nth-child(1){left:3%;top:4%;--delay:-2s}
.ambient span:nth-child(2){right:2%;top:26%;--delay:-7s}
.ambient span:nth-child(3){left:10%;top:64%;--delay:-4s}
.ambient span:nth-child(4){right:12%;top:83%;--delay:-10s}
.ambient span:nth-child(5){left:67%;top:1%;--delay:-5s}
.ambient span:nth-child(6){left:37%;top:46%;--delay:-9s}
#app{position:relative;z-index:1;max-width:480px;width:100%;margin:auto;min-height:100vh;min-height:100dvh;padding:calc(18px + env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) calc(18px + env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))}
.screen{animation:screen-enter .3s ease both}
.eyebrow{font-size:10px;font-weight:800;letter-spacing:2px;line-height:1.6;color:var(--muted)}
.red-text{color:var(--red)}
.home-heading{text-align:center;padding-top:10px}
.brand-symbol{width:46px;height:38px;margin:0 auto 10px;display:block}
.brand-symbol path{stroke-width:4.5;stroke-linecap:round;stroke-linejoin:round;fill:none}
.home-heading h1{font-size:clamp(54px,17vw,76px);letter-spacing:-4px;font-weight:900;line-height:.91;margin:16px 0 12px}
.home-heading h1 span{display:block;color:var(--red)}
.home-heading .tagline{font-size:14px;line-height:1.5;color:var(--muted)}
.home-art{position:relative;display:flex;justify-content:center;align-items:center;height:244px;margin:8px 0}
.preview-shell{position:relative;width:212px;transform:rotate(-7deg);animation:preview-float 5s ease-in-out infinite}
.preview-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;padding:10px;border:1px solid #fff;border-radius:24px;background:#fff;box-shadow:0 18px 36px #23233014,0 3px 8px #23233008}
.preview-grid>span{position:relative;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;border-radius:9px;color:#a4a6ad;background:#f4f4f7}
.preview-grid>.preview-red{background:#ffe4dd;color:var(--red)}
.preview-grid>.preview-black{background:#e6e7eb;color:var(--ink)}
.preview-grid>.preview-goal{background:#fff0cb;color:#80600e}
.mini-token{position:absolute;top:-3px;left:-3px;width:18px;height:18px;display:grid;place-items:center;font-size:10px;font-style:normal;color:white;border:2px solid white;border-radius:50%}
.mini-red{background:var(--red)}
.mini-black{background:var(--ink);border-radius:5px}
.art-chip{position:absolute;z-index:2;padding:9px 13px;font-size:10px;font-weight:800;letter-spacing:1px;background:white;border:1px solid var(--line);border-radius:12px;box-shadow:0 5px 15px #20232c0c;transform:rotate(7deg)}
.art-chip.you{bottom:5px;left:-40px;color:var(--red)}
.art-chip.rival{right:-39px;top:8px}
.art-chip b{display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:5px}
.home-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:15px 0;background:#ffffffbc;border:1px solid white;border-radius:20px;margin-bottom:20px}
.stat{text-align:center;min-width:0}
.stat+.stat{border-left:1px solid var(--line)}
.stat strong{display:block;font-size:clamp(18px,5vw,23px);font-weight:850;font-variant-numeric:tabular-nums}
.stat small{display:block;margin-top:4px;font-size:9px;letter-spacing:1.3px;font-weight:750;color:var(--muted)}
.mode-heading{margin:0 0 9px 2px;font-size:10px;font-weight:800;letter-spacing:1.5px;color:var(--muted)}
.mode-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:14px}
.mode-option{min-height:82px;padding:11px 3px 9px;border:1px solid #e5e4e8;border-radius:15px;background:#ffffffb8;min-width:0}
.mode-option .mode-icon{display:block;font-size:23px;line-height:1.1;margin-bottom:6px}
.mode-option strong{display:block;font-size:10px;letter-spacing:.5px}
.mode-option small{display:block;margin-top:4px;font-size:10px;color:var(--muted)}
.mode-option.selected{background:var(--red-light);border-color:var(--red);box-shadow:0 0 0 1px var(--red)}
.mode-option.selected .mode-icon{color:var(--red)}
.button{border:0;min-height:52px;border-radius:16px;padding:15px 20px;font-weight:800;font-size:14px;letter-spacing:.8px;width:100%;display:flex;align-items:center;justify-content:center;gap:10px}
.primary{background:var(--red);color:white;box-shadow:0 7px 18px #dc382f25}
.secondary{background:var(--ink);color:white}
.ghost{background:transparent;color:var(--muted)}
.play-button{min-height:78px;justify-content:space-between;padding:15px 23px;border-radius:20px;margin-bottom:12px;text-align:left}
.play-button strong{display:block;font-size:23px;letter-spacing:1.5px}
.play-button small{display:block;font-size:9px;letter-spacing:1px;margin-top:5px;opacity:.9}
.play-button .play-arrow{font-size:32px;font-weight:400}
.home-menu{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.menu-button{min-height:54px;border:1px solid #e6e5e9;border-radius:15px;background:white;font-size:11px;letter-spacing:.7px;font-weight:800;padding:10px;display:flex;align-items:center;justify-content:center;gap:9px}
.menu-button .menu-symbol{font-size:21px;font-weight:600}
.home-menu .wide{grid-column:1/-1}
.storage-note{text-align:center;font-size:10px;line-height:1.5;color:var(--muted);margin:18px 0 4px}
.screen-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.icon-button{width:44px;height:44px;flex:0 0 44px;display:grid;place-items:center;padding:0;background:white;border:1px solid var(--line);border-radius:14px;font-size:24px;line-height:1}
.header-copy{min-width:0}
.header-copy h2{font-size:25px;letter-spacing:-.8px}
.header-copy p{font-size:11px;color:var(--muted);margin-top:4px}
.levels-intro{font-size:14px;line-height:1.6;color:var(--muted);margin-bottom:17px}
.levels-mode{display:inline-flex;border-radius:9px;background:var(--red-light);color:var(--red);padding:8px 11px;font-size:10px;font-weight:800;letter-spacing:.5px;margin-bottom:16px}
.level-list{display:grid;gap:10px}
.level-card{display:grid;grid-template-columns:45px minmax(0,1fr) auto;gap:12px;align-items:center;text-align:left;padding:14px 12px;border:1px solid var(--line);border-radius:18px;background:white;min-height:76px}
.level-number{width:44px;height:44px;display:grid;place-items:center;background:#f1f1f5;border-radius:13px;font-size:20px;font-weight:850;font-variant-numeric:tabular-nums}
.ready .level-number{background:var(--red-light);color:var(--red)}
.cleared .level-number{background:var(--ink);color:white}
.level-copy{min-width:0}
.level-copy strong{display:block;font-size:14px}
.level-copy small{display:block;font-size:10px;color:var(--muted);line-height:1.5;margin-top:4px}
.level-status{font-size:10px;letter-spacing:.4px;font-weight:800;color:var(--red)}
.cleared .level-status{font-size:15px;color:#956719;letter-spacing:0}
.level-card.locked{background:#f0eff2;opacity:.65}
.locked .level-status{color:var(--muted);font-size:8px}
.levels-footer{text-align:center;color:var(--muted);font-size:11px;margin:20px 0}
.game-header{margin-bottom:13px}
.game-header h2{font-size:18px;letter-spacing:1px}
.game-header p{font-size:10px}
.hud{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:13px}
.hud-item{min-width:0;padding:11px 8px;text-align:center;background:white;border:1px solid var(--line);border-radius:15px}
.hud-item small{display:block;font-size:9px;font-weight:800;letter-spacing:1.4px;color:var(--muted);margin-bottom:5px}
.hud-item strong{display:block;font-size:clamp(18px,5.5vw,24px);font-weight:850;font-variant-numeric:tabular-nums;line-height:1.1}
.hud-score strong{color:var(--red)}
.racers{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px}
.racers.single{grid-template-columns:1fr}
.racer-card{padding:11px;border:1px solid var(--line);border-radius:16px;background:white;min-width:0;text-align:left;opacity:1!important;cursor:default}
.racer-card:not(:disabled){cursor:pointer}
.racer-card.selected{border-color:#e5aaa5}
.racer-card.black-card.selected{border-color:#737783}
.racer-top{display:flex;align-items:center;gap:8px}
.avatar{width:27px;height:27px;flex:0 0 27px;display:grid;place-items:center;border-radius:50%;background:var(--red);color:white;font-size:12px;font-weight:800}
.avatar.black{background:var(--ink);border-radius:7px;transform:rotate(45deg);width:24px;height:24px;flex-basis:24px;margin:0 2px}
.avatar.black span{transform:rotate(-45deg)}
.racer-copy{min-width:0;flex:1}
.racer-copy strong{display:block;font-size:9px;letter-spacing:.5px}
.racer-copy small{display:block;font-size:10px;color:var(--muted);margin-top:3px;font-variant-numeric:tabular-nums}
.racer-arrows{font-size:21px;font-weight:850;white-space:nowrap;line-height:1;color:var(--red);letter-spacing:-1px}
.black-card .racer-arrows{color:var(--ink)}
.progress-track{height:5px;background:#f0edf0;border-radius:4px;margin-top:11px;overflow:hidden}
.progress-fill{height:100%;width:0;background:var(--red);border-radius:4px;transition:width .22s}
.black-card .progress-fill{background:var(--ink)}
.feedback{min-height:42px;display:flex;align-items:center;justify-content:center;padding:8px 4px;font-size:11px;line-height:1.5;text-align:center;color:var(--muted)}
.feedback.good{color:#a82a24}
.feedback.warning{color:#925a14;font-weight:650}
.board{position:relative;width:100%;aspect-ratio:1;border:1px solid #e3e2e8;border-radius:23px;background:#eeedf2;box-shadow:0 10px 25px #20232c0b;scroll-margin-bottom:210px}
.board-inner{position:absolute;inset:8px}
.board-grid{position:absolute;inset:0;display:grid;grid-template-rows:repeat(var(--n),minmax(0,1fr));gap:4px}
.cell{position:relative;display:flex;align-items:center;justify-content:center;min-width:0;min-height:0;padding:2px;border:1px solid #e7e6eb;border-radius:10px;background:white;-webkit-user-select:none;user-select:none}
.cell:focus-visible{outline-offset:-3px;z-index:8}
.arrows{position:relative;z-index:4;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0 1px;max-width:100%;font-size:24px;font-weight:800;line-height:1.05}
.arrows.count-2{font-size:19px}
.arrows.count-3,.arrows.count-4{display:grid;grid-template-columns:repeat(2,1fr);font-size:16px;gap:0 2px}
.dense .cell{border-radius:7px}
.dense .arrows{font-size:21px}
.dense .arrows.count-2{font-size:15px}
.dense .arrows.count-3,.dense .arrows.count-4{font-size:13px;gap:0 1px}
.cell.visited-red{background:#fff0ed}
.cell.visited-black{background:#ececf0}
.cell.visited-red.visited-black{background:linear-gradient(135deg,#fff0ed 48%,#ececf0 52%)}
.current-red{border:2px solid var(--red)}
.current-black{border:2px dashed var(--ink)}
.current-red.current-black{border:2px solid var(--red);box-shadow:inset -3px -3px 0 var(--ink)}
.cell.goal{background:#fff1c9;border-color:#efdc9c}
.finish-flag{position:relative;z-index:4;width:28px;height:28px;color:#624b1c}
.dense .finish-flag{width:22px;height:22px}
.tile-badge{position:absolute;right:2px;bottom:1px;z-index:4;display:grid;place-items:center;min-width:12px;height:12px;border-radius:4px;font-size:10px;line-height:1;font-weight:850}
.tile-badge.bonus{color:#8c5c0a;background:#ffe5a0}
.tile-badge.trap{color:#854807;background:#ffe4c5}
.tile-badge.dead{color:#626571;background:#eeedf2}
.dead .arrows{opacity:.62}
.board-lines{position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none;overflow:visible}
.board-links{stroke:#bbbcc6;stroke-width:.035;opacity:.3;stroke-linecap:round}
.trail{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:.065;opacity:.45}
.red-trail{stroke:var(--red)}
.black-trail{stroke:var(--ink);stroke-dasharray:.12 .075;stroke-width:.055}
.token{position:absolute;z-index:7;display:grid;place-items:center;width:19px;height:19px;color:white;font-size:10px;font-weight:850;background:var(--red);border:2px solid white;border-radius:50%;box-shadow:0 2px 5px #20232c33;transform:translate(-50%,-50%);transition:left .16s ease,top .16s ease;pointer-events:none}
.token.black{background:var(--ink);border-radius:5px;transform:translate(-50%,-50%) rotate(45deg)}
.token.black span{transform:rotate(-45deg)}
.dense .token{width:15px;height:15px;font-size:8px;border-width:1.5px}
.token.stunned{animation:token-blink .45s ease-in-out infinite}
.cell.hinted{box-shadow:inset 0 0 0 3px #dda022;background:#fff4d6}
.beginner-next{outline:2px solid #d7746a;outline-offset:-3px}
.correct-flash
.shake{animation:wrong-shake .32s ease}
.countdown{position:absolute;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;border-radius:inherit;background:#ffffffc9;-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.countdown strong{font-size:88px;font-weight:900;line-height:1;color:var(--red);letter-spacing:-5px}
.countdown small{font-size:9px;font-weight:850;letter-spacing:1.8px;color:var(--ink)}
.legend{display:flex;justify-content:space-between;gap:4px;padding:12px 1px 7px;font-size:10px;color:var(--muted)}
.legend span{white-space:nowrap}
.legend b{color:var(--ink);margin-right:2px;font-size:12px}
.legend .legend-bonus{color:#936615}
.keyboard-note{font-size:10px;color:var(--muted);line-height:1.6;text-align:center;margin:0 0 3px}
.controls-dock{position:sticky;bottom:0;z-index:20;padding:9px 0 calc(4px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid #f0eef0;margin-top:4px}
.direction-controls{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:9px}
.direction-controls.two-player{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.pad{min-width:0}
.pad-buttons{display:grid;grid-template-columns:repeat(4,minmax(44px,1fr));gap:7px;touch-action:none}
.two-player .pad-buttons{grid-template-columns:repeat(2,minmax(44px,1fr));gap:6px}
.pad-label{display:flex;justify-content:space-between;align-items:center;margin:1px 2px 7px;font-size:9px;letter-spacing:.6px}
.pad-label b{color:var(--red)}
.black-pad .pad-label b{color:var(--ink)}
.pad-label span{color:var(--muted);font-size:8px;font-weight:750}
.direction{min-height:48px;border:1px solid #e5e3e8;border-radius:13px;background:white;color:var(--red);font-size:26px;font-weight:750;touch-action:none}
.black-pad .direction{color:var(--ink)}
.direction:disabled{opacity:.4}
.game-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.utility-button{min-height:46px;border:1px solid #e1dfe5;border-radius:13px;background:white;font-size:11px;font-weight:800;letter-spacing:.6px;display:flex;align-items:center;justify-content:center;gap:8px}
.utility-button .utility-icon{font-size:18px}
.hint-count{display:grid;place-items:center;min-width:20px;height:20px;border-radius:6px;background:#fff0cc;color:#7d5519;font-size:10px}
.modal-open{overflow:hidden}
.modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:calc(18px + env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) calc(18px + env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left));background:#181a2866;-webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px);overflow:auto}
.modal-card{position:relative;width:100%;max-width:390px;max-height:calc(100vh - 60px);max-height:calc(100dvh - 60px - env(safe-area-inset-top) - env(safe-area-inset-bottom));overflow-y:auto;overscroll-behavior:contain;padding:29px 24px 20px;border:1px solid white;border-radius:28px;background:#fff;box-shadow:0 25px 80px #15172733;text-align:center;animation:modal-enter .25s ease both}
.modal-card h2{font-size:29px;line-height:1.15;letter-spacing:-1px;margin:9px 0 20px;font-weight:900}
.modal-card .button{margin-top:9px}
.modal-copy{font-size:12px;color:var(--muted);line-height:1.7;margin:12px 0 20px}
.modal-icon{font-size:35px;line-height:1;margin:3px 0 15px;color:var(--red)}
.modal-close{position:absolute;right:12px;top:12px;background:#f5f4f6;border:0;width:36px;height:36px;min-height:36px;font-size:24px;border-radius:11px}
.result-stars{margin:0 0 22px;font-size:48px;letter-spacing:4px;color:#b77d17;white-space:nowrap}
.empty-stars{color:#e7e6e9}
.result-emblem{font-size:48px;color:var(--red);margin-bottom:16px}
.result-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 15px}
.result-stats>div{background:#f6f5f8;border-radius:16px;padding:16px 8px}
.result-stats span{display:block;font-size:9px;font-weight:800;color:var(--muted);letter-spacing:1.5px;margin-bottom:7px}
.result-stats strong{font-size:24px;font-weight:850;font-variant-numeric:tabular-nums}
.result-note{font-size:11px;line-height:1.6;color:var(--muted);margin-bottom:20px}
.campaign-note{font-size:10px;letter-spacing:1px;color:var(--red);font-weight:850;margin:15px 0}
.setting-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:19px 0;border-bottom:1px solid var(--line);text-align:left}
.setting-row strong{display:block;font-size:14px}
.setting-row small{display:block;font-size:10px;color:var(--muted);line-height:1.5;margin-top:5px}
.switch{position:relative;display:block;width:47px;height:29px;flex:0 0 47px}
.switch input{position:absolute;inset:0;opacity:0;margin:0;width:100%;height:100%;cursor:pointer}
.switch-track{position:absolute;inset:0;background:#dcdce3;border-radius:20px;pointer-events:none;transition:background .2s}
.switch-track
.switch input:checked+.switch-track{background:var(--red)}
.switch input:checked+.switch-track
.switch input:focus-visible+.switch-track{outline:3px solid #346cc7;outline-offset:4px}
.difficulty-setting{text-align:left;padding-top:23px}
.difficulty-setting>strong{font-size:14px}
.difficulty-setting .modal-copy{margin:8px 0 14px;font-size:11px}
.difficulty-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.difficulty-options button{min-height:46px;padding:7px 3px;background:#f5f4f7;border:1px solid #eeecf0;border-radius:12px;font-size:11px;font-weight:750}
.difficulty-options .selected{background:var(--red-light);border-color:var(--red);color:var(--red)}
.settings-footnote{margin:23px 0 17px;font-size:10px;color:var(--muted);line-height:1.7}
.help-example{display:flex;align-items:center;justify-content:center;gap:10px;font-size:24px;background:#f5f4f7;border-radius:16px;padding:16px;margin-bottom:19px}
.example-token{display:grid;place-items:center;width:27px;height:27px;background:var(--red);color:white;border-radius:50%;font-size:13px;font-weight:800}
.example-next{padding:3px 9px;border:2px solid var(--red);border-radius:9px}
.help-steps{text-align:left;padding-left:23px;margin:0 0 17px;font-size:12px;line-height:1.7;color:var(--muted)}
.help-steps li{padding-left:4px;margin-bottom:11px}
.help-steps strong{color:var(--ink)}
